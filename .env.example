# Boris Assistant — local development environment
# Copy to `.env` and fill in values as needed:
#   cp .env.example .env
#
# Secrets may also live in `~/.boris/auth.json` (or %USERPROFILE%\.boris\auth.json).
# Never commit real keys. `.env` is gitignored; this file is the tracked template.

# OpenRouter (or OpenAI-compatible) API key for the cloud LLM path
OPENROUTER_API_KEY=

# Default / strong model id (e.g. google/gemini-2.5-flash-lite)
OPENROUTER_MODEL=

# Override data root (default: ~/.boris)
# BORIS_HOME=

# Log filter for the desktop host (also accepts RUST_LOG)
# BORIS_LOG=info
# RUST_LOG=info

# Capability preset: voice_safe | local_power | full
# BORIS_CAPABILITY=full

# Optional mirror base for model install (see boris-pipeline install_models)
# BORIS_MODEL_BASE_URL=

# Hugging Face token when downloads require auth (also HUGGING_FACE_HUB_TOKEN)
# HF_TOKEN=
