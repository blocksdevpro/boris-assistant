{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boris",
  "version": "1.0.0",
  "identifier": "com.boris.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun run verify:bundle-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boris",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "center": true
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Boris",
        "width": 444,
        "height": 184,
        "minWidth": 333,
        "minHeight": 138,
        "maxWidth": 555,
        "maxHeight": 230,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "center": false,
        "focus": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ort/": "./"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyRjBCRDhCRDQzOEJDNDgKUldSSXZEalVpNzN3c25uLy9ucFJwdzBsOGFCR0tONDJUbS82RExSUUFlTG9iZXFOKzBUM0FyeDMK",
      "endpoints": [
        "https://github.com/blocksdevpro/boris-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
